#!/bin/sh
echo "============================================="
echo "   Running Pre-Push Verification Pipeline   "
echo "============================================="

# 1. Full build (catches vite / TS / bundler errors)
echo ""
echo "[1/3] Running Build..."
bun run build || {
  echo ""
  echo "ERROR: Build failed!"
  exit 1
}

# 2. Component tests (jsdom) — mirrors the CI component-tests job
echo ""
echo "[2/4] Running Component Tests..."
bun run --filter photrez-desktop test:component || {
  echo ""
  echo "ERROR: Component tests failed!"
  exit 1
}

# 3. Rust format check — mirrors the CI Format check hard gate (this one is
#    NOT covered by cargo check/build/test: rustfmt diff only shows on push).
echo ""
echo "[3/4] Running cargo fmt --check..."
cargo fmt --check || {
  echo ""
  echo "ERROR: rustfmt diff detected. Run 'cargo fmt' and re-stage."
  exit 1
}

# 4. Dependency audit — mirrors the CI Security audit job (bun side). Advisory
#    must be patched via root "overrides" + `bun install` before pushing.
echo ""
echo "[4/4] Running bun audit (high/critical)..."
bun audit --prod --audit-level=high || {
  echo ""
  echo "ERROR: HIGH/CVSS advisory found. Bump the root 'overrides'"
  echo "       (e.g. undici, fast-uri) to the patched version,"
  echo "       run 'bun install', and re-stage bun.lock."
  exit 1
}

# 5. Lockfile guard — ensure bun.lock is in sync with package.json so the
#    CI `bun install --frozen-lockfile` step does not fail after a dependency
#    change. If this fails, run `bun install` and re-stage bun.lock.
echo ""
echo "[5/5] Verifying bun.lock is in sync..."
bun install --frozen-lockfile || {
  echo ""
  echo "ERROR: bun.lock is out of sync with package.json."
  echo "       Run 'bun install' and stage the updated bun.lock before pushing."
  exit 1
}

echo ""
echo "All pre-push checks passed. Proceeding with push."
