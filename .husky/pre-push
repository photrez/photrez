#!/bin/sh
echo "============================================="
echo "   Running Pre-Push Verification Pipeline   "
echo "============================================="

# NOTE 2026-10-17: the build and component-test steps were removed with the
# browser build pipeline — the component suite loads that build, and it can no
# longer be produced in this tree. Both return with the native build.

# 1. Rust format check — mirrors the CI Format check hard gate (this one is
#    NOT covered by cargo check/build/test: rustfmt diff only shows on push).
echo ""
echo "[1/3] Running cargo fmt --check..."
cargo fmt --check || {
  echo ""
  echo "ERROR: rustfmt diff detected. Run 'cargo fmt' and re-stage."
  exit 1
}

# 4. Dependency audit — mirrors the CI Security audit job (bun side). Advisory
#    must be patched via root "overrides" + `bun install` before pushing.
#    Ignored advisories match the CI job's list exactly (see .github/workflows/ci.yml):
#    transitive-only, no patched version published yet, last reviewed 2026-10-15.
echo ""
echo "[2/3] Running bun audit (high/critical)..."
bun audit --prod --audit-level=high \
  --ignore GHSA-r28c-9q8g-f849 --ignore GHSA-2pvr-wf23-7pc7 --ignore GHSA-8hv8-536x-4wqp \
  --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-ch52-4w7c-c8xp || {
  echo ""
  echo "ERROR: HIGH/CVSS advisory found. Bump the root 'overrides'"
  echo "       (e.g. undici, fast-uri) to the patched version,"
  echo "       run 'bun install', and re-stage bun.lock."
  echo "       If no patched version exists, add the advisory to BOTH this"
  echo "       ignore list and ci.yml with a revisit date."
  exit 1
}

# 5. Lockfile guard — ensure bun.lock is in sync with package.json so the
#    CI `bun install --frozen-lockfile` step does not fail after a dependency
#    change. If this fails, run `bun install` and re-stage bun.lock.
echo ""
echo "[3/3] Verifying bun.lock is in sync..."
bun install --frozen-lockfile || {
  echo ""
  echo "ERROR: bun.lock is out of sync with package.json."
  echo "       Run 'bun install' and stage the updated bun.lock before pushing."
  exit 1
}

echo ""
echo "All pre-push checks passed. Proceeding with push."
