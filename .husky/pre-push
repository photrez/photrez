#!/bin/sh
set -e

echo "============================================="
echo "   Running Pre-Push Verification Pipeline   "
echo "============================================="

echo ""
echo "[1/4] Running cargo fmt --check..."
cargo fmt --check

echo ""
echo "[2/4] Running core Clippy..."
cargo clippy -p photrez-core -- -D warnings

echo ""
echo "[3/4] Checking package boundaries..."
sh scripts/check-package-boundaries.sh

echo ""
echo "[4/4] Running workspace tests..."
cargo test --workspace

echo ""
echo "All pre-push checks passed. Proceeding with push."
