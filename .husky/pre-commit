#!/bin/sh
echo "============================================="
echo "   Running Pre-Commit Verification Pipeline  "
echo "============================================="

# 0a. Block internal workflow labels in staged source files
if git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|rs|sh)$' | xargs grep -ln 'ponytail:' 2>/dev/null | grep -q .; then
  echo ""
  echo "ERROR: Internal label pattern detected in staged source files."
  exit 1
fi

# 0c. Optional local checks, when the developer provides them. These files are
# not part of the public tree; CI runs the public guard only.
LOCAL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|rs|md|sh|txt)$' | tr '\n' ' ' || true)
if [ -n "$LOCAL_FILES" ] && [ -f ".husky/check-local-vocabulary.sh" ]; then
  sh .husky/check-local-vocabulary.sh --files "$LOCAL_FILES" || exit 1
fi

# 0e. Public-artifact terminology guard: staged source + public markdown
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(ts|tsx|rs|md)$'; then
  FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|rs|md)$' | tr '\n' ' ')
  sh scripts/check-public-terminology.sh --files "$FILES" || exit 1
fi

# 0f. Public stack-surface staleness: no tracked public surface may still
# assert a runtime stack the tree no longer contains. The token list
# (scripts/public-stack-tokens.txt) is the single source of truth.
sh scripts/check-public-terminology.sh --staleness || exit 1

# 0g. Hardcoded UI strings: staged Rust files under the swept trees must route
# their user-visible text through the message catalog (t("key")), or carry an
# explicit `// i18n-exempt: <reason>` marker.
I18N_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^crates/photrez/src/(views|components)/.*\.rs$' | tr '\n' ' ' || true)
if [ -n "$I18N_FILES" ]; then
  sh scripts/check-public-terminology.sh --i18n --files "$I18N_FILES" || exit 1
fi

# Rust core unit tests
echo ""
echo "Running Rust Core Tests..."
cargo test -p photrez-core || {
  echo ""
  echo "ERROR: Rust core tests failed!"
  exit 1
}

echo ""
echo "Pre-commit checks passed. (Format, lint, and workspace tests run on pre-push.)"
